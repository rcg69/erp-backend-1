DATABASE_URL=postgresql://user:password@localhost:5432/student_erp
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=http://localhost:3000
# Configure SMTP to deliver recovery messages. When SMTP_HOST is omitted in
# development, the reset link is written to the backend console for local use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
